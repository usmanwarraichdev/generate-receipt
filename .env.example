# -----------------------------------------------------------------------------------------------
# Folio environment variables. Copy this file to .env.local and fill it in.
# Everything here is read on the server only: nothing uses the NEXT_PUBLIC_ prefix, so no value
# is ever sent to the browser. Never commit .env.local.
# -----------------------------------------------------------------------------------------------

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Secret keys (starts with sb_secret_).
# It bypasses row-level security, so it must stay on the server.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Resend → API Keys (starts with re_)
RESEND_API_KEY=re_replace_me

# The sender. Without a verified domain, use Resend's test sender: it only delivers to the email
# address of your own Resend account (or to Resend's test inbox, delivered@resend.dev).
EMAIL_FROM="Folio <onboarding@resend.dev>"

# Optional safety rails for a public deployment (the API has no authentication).
# Comma-separated addresses and/or @domains allowed to receive invoices. Empty = no restriction.
EMAIL_ALLOWED_RECIPIENTS=
# Maximum email attempts per hour across the whole app.
EMAIL_HOURLY_LIMIT=20

# Public URL of the app, used for the "View & download invoice" link in emails.
# Optional: when empty, the URL the request came in on is used.
APP_URL=http://localhost:3000
